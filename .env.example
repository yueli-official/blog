# Blog complete standalone topology.
BLOG_POSTGRES_USER=blog
BLOG_POSTGRES_PASSWORD=
BLOG_POSTGRES_DB=blog
BLOG_DATABASE_URL=postgres://blog:${BLOG_POSTGRES_PASSWORD}@blog-postgres:5432/blog?sslmode=disable
BLOG_API_PORT=8085
BLOG_WEB_PORT=3002
BLOG_PUBLIC_ORIGIN=http://localhost:3002
BLOG_SITE_KEY=blog-main
BLOG_SITE_BRAND=月离博客
BLOG_SITE_DOMAIN=blog.localhost
BLOG_SITE_DESCRIPTION=想法、笔记与记录
BLOG_WEB_SEAL_SECRET=
BLOG_COOKIE_SECURE=false

BLOG_ADMIN_SUB=
BLOG_ADMIN_EMAIL=
BLOG_ADMIN_PASSWORD=
BLOG_ADMIN_DISPLAY_NAME=Blog Administrator
# Optional unattended bootstrap. Leave [] to use the one-time in-product claim flow.
BLOG_BOOTSTRAP_ADMIN_SUBS=[]

IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_DB=identity
IDENTITY_DATABASE_URL=postgres://identity:${IDENTITY_POSTGRES_PASSWORD}@identity-postgres:5432/identity?sslmode=disable
IDENTITY_GLOBAL_SECRET=
IDENTITY_PORT=8081
IDENTITY_ACCOUNT_PORT=3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEBAUTHN_RPID=localhost
IDENTITY_WEBAUTHN_ORIGINS=["http://localhost:3000"]
IDENTITY_ALLOW_PRIVATE_HTTP_REDIRECTS=false
BLOG_IDENTITY_ISSUER=http://localhost:8081
BLOG_IDENTITY_INTERNAL_URL=http://identity:8081
BLOG_IDENTITY_DISCOVERY_URL=https://identity-internal:8443/.well-known/openid-configuration
BLOG_IDENTITY_JWKS_URL=https://identity-internal:8443/oauth2/jwks.json
BLOG_ACCOUNT_ORIGIN=http://localhost:3000
BLOG_OIDC_CLIENT_ID=blog-main-web
BLOG_OIDC_REDIRECT_URI=http://localhost:3002/auth/callback
BLOG_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3002/
BLOG_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false
BLOG_ALLOW_LOOPBACK_IDENTITY_HTTP=false

ASSET_POSTGRES_USER=asset
ASSET_POSTGRES_PASSWORD=
ASSET_POSTGRES_DB=asset
ASSET_DATABASE_URL=postgres://asset:${ASSET_POSTGRES_PASSWORD}@asset-postgres:5432/asset?sslmode=disable
ASSET_UPLOAD_SECRET=
ASSET_STORAGE_CONFIG_SECRET=
ASSET_PORT=8082
BLOG_ASSET_INTERNAL_URL=http://asset:8082
BLOG_ASSET_PUBLIC_ORIGIN=http://localhost:8082
BLOG_ASSET_SPACE=yueli
BLOG_ASSET_NAMESPACE=blog-main
BLOG_ASSET_PROFILE=blog-post
BLOG_COVER_CATEGORY=blog-cover
BLOG_ASSET_CLIENT_ID=blog-asset-svc
BLOG_ASSET_CLIENT_SECRET=
BLOG_ASSET_SCOPE=asset:sign
BLOG_BINDING_ALLOW_INSECURE_ASSET_HTTP=true
ASSET_ALLOW_LOOPBACK_IDENTITY_HTTP=false

BLOG_MAILER_MODE=dev
BLOG_SMTP_HOST=
BLOG_SMTP_PORT=465
BLOG_SMTP_USERNAME=
BLOG_SMTP_PASSWORD=
BLOG_SMTP_FROM=
BLOG_SMTP_FROM_NAME=月离博客

BLOG_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
