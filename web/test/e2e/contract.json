{
  "$schema": "./contract.schema.json",
  "version": 1,
  "public": { "path": "/", "readySelector": "[data-blog-home-ready]" },
  "manage": {
    "path": "/manage",
    "heading": "控制台",
    "readySelector": "#manage-main",
    "settings": { "path": "/manage/settings", "fieldLabel": "站点名称" },
    "views": [
      { "key": "list", "label": "列表视图" },
      { "key": "grid", "label": "网格视图" }
    ]
  },
  "empty": {
    "path": "/search?q=__blog_e2e_missing__",
    "text": "没有匹配“__blog_e2e_missing__”的文章"
  },
  "error": {
    "path": "/posts/__blog_e2e_missing__",
    "status": 404,
    "text": "文章不存在"
  },
  "visual": { "managePath": "/manage/posts" },
  "features": { "assetSettings": true }
}
