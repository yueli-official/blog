{
  "$schema": "../../asset/contracts/asset-consumer-declaration.schema.json",
  "consumerKey": "blog",
  "namespaceKey": "blog",
  "displayName": "月离博客",
  "bindings": [
    { "kind": "oauth-client", "subject": "blog-main-web" },
    { "kind": "service-client", "subject": "blog-asset-svc" }
  ],
  "referenceLifecycle": {"complete": true, "strategy": "snapshot", "coverage": "启动及每15秒以数据库快照登记文章正文、封面、SEO图片和系列封面；软删除撤销，恢复重建，替换仅撤销旧关系；读取或提交失败保留既有引用并重试。"},
  "profiles": [
    {
      "key": "blog-cover",
      "kind": "public-image",
      "purpose": "文章封面",
      "allowedMimes": ["image/webp", "image/gif"],
      "maxBytes": 10485760,
      "maxPixels": 30000000,
      "visibility": "public",
      "metadataPolicy": "strip",
      "keepOriginal": true,
      "storageClass": "public-media",
      "variants": [
        { "key": "card", "width": 600, "height": 400, "mode": "fill", "format": "webp", "quality": 85, "visibility": "public", "metadataPolicy": "strip", "presets": [
          { "key": "standard", "width": 600, "height": 400, "mode": "fill", "format": "webp", "quality": 85 },
          { "key": "compact", "width": 480, "height": 320, "mode": "fill", "format": "webp", "quality": 82 }
        ] },
        { "key": "home", "width": 1200, "height": 800, "mode": "fill", "format": "webp", "quality": 88, "visibility": "public", "metadataPolicy": "strip", "presets": [
          { "key": "standard", "width": 1200, "height": 800, "mode": "fill", "format": "webp", "quality": 88 },
          { "key": "compact", "width": 900, "height": 600, "mode": "fill", "format": "webp", "quality": 84 }
        ] },
        { "key": "thumbnail", "width": 300, "height": 200, "mode": "fill", "format": "webp", "quality": 82, "visibility": "public", "metadataPolicy": "strip", "presets": [
          { "key": "standard", "width": 300, "height": 200, "mode": "fill", "format": "webp", "quality": 82 },
          { "key": "sharp", "width": 450, "height": 300, "mode": "fill", "format": "webp", "quality": 85 }
        ] },
        { "key": "og", "width": 1200, "height": 630, "mode": "fill", "format": "jpeg", "quality": 88, "visibility": "public", "metadataPolicy": "strip", "presets": [
          { "key": "fixed", "width": 1200, "height": 630, "mode": "fill", "format": "jpeg", "quality": 88 }
        ] }
      ]
    },
    {
      "key": "blog-post",
      "kind": "public-image",
      "purpose": "文章正文图片",
      "allowedMimes": ["image/webp", "image/gif"],
      "maxBytes": 10485760,
      "maxPixels": 30000000,
      "visibility": "public",
      "metadataPolicy": "strip",
      "keepOriginal": true,
      "storageClass": "public-media",
      "variants": [
        { "key": "inline", "width": 900, "height": 900, "mode": "resize-width", "format": "webp", "quality": 84, "visibility": "public", "metadataPolicy": "strip", "presets": [
          { "key": "standard", "width": 900, "height": 900, "mode": "resize-width", "format": "webp", "quality": 84 },
          { "key": "compact", "width": 720, "height": 720, "mode": "resize-width", "format": "webp", "quality": 82 }
        ] },
        { "key": "content", "width": 1200, "height": 1200, "mode": "resize-width", "format": "webp", "quality": 88, "visibility": "public", "metadataPolicy": "strip", "presets": [
          { "key": "fixed", "width": 1200, "height": 1200, "mode": "resize-width", "format": "webp", "quality": 88 }
        ] }
      ]
    }
  ]
}
